# KopiyanteaPOS — Environment Variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Supabase: Production (used by client app + supabase-ping.yml) ---
# Supabase project URL (e.g. https://xxxxx.supabase.co)
SUPABASE_URL=

# Supabase publishable key (`sb_publishable_...`) — Settings → API in the
# Supabase dashboard. The legacy JWT anon key also works here, but the
# publishable key is the recommended replacement (per-key revocation,
# rotation-friendly). NEVER place a secret/service_role key on the client.
SUPABASE_PUBLISHABLE_KEY=

# --- Supabase: Development (used by .env.dev + supabase-ping-dev.yml) ---
# A separate Supabase project used for local development. Populate with
# the URL and publishable key of the dev project (see `.env.dev` for a
# working example). Required as GitHub Actions secrets for the
# `Supabase Keep-Alive (Dev)` workflow.
SUPABASE_DEV_URL=
SUPABASE_DEV_PUBLISHABLE_KEY=

# Environment: development | staging | production
APP_ENV=development

# Comma-separated SHA-256 cert fingerprints for Supabase cert pinning (production only).
# Format: AA:BB:CC:...  Include current + next fingerprint during rotation overlap.
SUPABASE_CERT_FINGERPRINTS=