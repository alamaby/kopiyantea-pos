# KopiyanteaPOS — Environment Variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Supabase: Production (used by client app + supabase-ping.yml) ---
# Supabase project URL (e.g. https://xxxxx.supabase.co)
SUPABASE_URL=

# Supabase publishable key (`sb_publishable_...`) — Settings → API in the
# Supabase dashboard (publishable key, rotation-friendly).
# NEVER place a secret/service_role key on the client.
SUPABASE_PUBLISHABLE_KEY=

# --- Supabase: Development (used by .env.dev + supabase-ping-dev.yml) ---
# A separate Supabase project used for local development. Populate with
# the URL and publishable key of the dev project (see `.env.dev` for a
# working example). Required as GitHub Actions secrets for the
# `Supabase Keep-Alive (Dev)` workflow.
SUPABASE_DEV_URL=
SUPABASE_DEV_PUBLISHABLE_KEY=

# --- GitHub Actions only: Supabase keep-alive auto-unpause ---
# Store these as GitHub Actions secrets, not mobile app env values. The PAT is
# used only by `.github/workflows/supabase-ping*.yml` to restore a paused free-
# tier project through the Supabase Management API.
SUPABASE_PROJECT_REF=
SUPABASE_PAT=
SUPABASE_DEV_PROJECT_REF=
SUPABASE_DEV_PAT=

# Environment: development | staging | production
APP_ENV=development

# Comma-separated SHA-256 cert fingerprints for Supabase cert pinning (production only).
# Format: AA:BB:CC:...  Include current + next fingerprint during rotation overlap.
SUPABASE_CERT_FINGERPRINTS=

# --- Supabase CLI only: Personal Access Token (`db push` / `functions deploy`) ---
# Real value ONLY in `.env.local`, NEVER in `.env` (lib/core/config/env.dart:18
# bakes `.env` into the binary via envied). Consumed via helper
# `scripts/supabase-with-token.ps1`, which reads the token from `.env.local`
# without ever printing it. Get one at Supabase Dashboard → Account → Access Tokens (prefix sbp_).
SUPABASE_ACCESS_TOKEN=sbp_...placeholder...
